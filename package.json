{
  "name": "flagpilot-flagsmith-agent",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "AI-assisted code-to-experiment agent with approval-gated Flagsmith operations.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "plan": "npm run build && node dist/src/commands/plan.js",
    "review:pr": "npm run build && node dist/src/commands/review-pr.js",
    "preflight": "npm run build && node dist/src/commands/preflight.js",
    "provision": "npm run build && node dist/src/commands/provision.js",
    "start": "npm run build && node dist/src/commands/start.js",
    "setup:environment": "npm run build && node dist/src/commands/setup-environment.js",
    "prepare:pr-proposal": "npm run build && node dist/src/commands/prepare-pr-proposal.js",
    "test:browser": "node --test tests/browser-console.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3",
    "playwright": "1.65.1"
  }
}
